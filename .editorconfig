root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# GDScript and the helper use one space of indentation (see CONTRIBUTING.md).
[*.{gd,gdshader,gdshaderinc,mjs,js}]
indent_style = space
indent_size = 1

[*.py]
indent_style = space
indent_size = 1

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

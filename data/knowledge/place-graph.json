  "spread": {
    "radius_m": 140,
    "min_neighbours": 2,
    "strength": 0.7,
    "kinds": ["style", "era"],
    "why": "Buildings of one block were mostly built in one boom by the same few architects: an undated building takes the style and era of its dated neighbours."
  },

  "rules": [
    { "if": ["district:art_deco", "form:lowrise"], "then": { "style:art_deco": 0.6 },
      "why": "Low buildings in the Art Deco district are mostly Art Deco." },
    { "if": ["district:art_deco", "form:midrise"], "then": { "style:art_deco": 0.55 } },
    { "if": ["district:art_deco", "form:tower"], "then": { "style:mimo": 0.5, "era:1950s": 0.4 },
      "why": "The district's towers are mostly MiMo (1950s-60s) or later condominiums." },
    { "if": ["district:art_deco"], "then": { "era:1930s": 0.55 } },
    { "if": ["district:pueblo"], "then": { "style:pueblo_revival": 0.85 } },
    { "if": ["district:creole"], "then": { "style:creole_townhouse": 0.85, "era:before_1900": 0.7 } },
    { "if": ["district:dense_core", "form:highrise"], "then": { "style:contemporary": 0.4, "style:modernism": 0.35 } },

    { "if": ["style:streamline_moderne"], "then": { "family:deco": 1.0 } },
    { "if": ["style:art_deco"], "then": { "family:deco": 1.0 } },

    { "if": ["family:deco", "form:lowrise"], "then": { "recipe:deco": 0.95 } },
    { "if": ["family:deco", "form:midrise"], "then": { "recipe:deco": 0.95 } },
    { "if": ["style:mimo"], "then": { "recipe:resort_tower": 0.9 } },
    { "if": ["district:art_deco", "form:tower"], "then": { "recipe:resort_tower": 0.85 } },
    { "if": ["style:mediterranean_revival"], "then": { "recipe:mediterranean": 0.9 } },
    { "if": ["style:spanish_colonial_revival"], "then": { "recipe:mediterranean": 0.9 } },
    { "if": ["style:mission_revival"], "then": { "recipe:mediterranean": 0.85 } },
    { "if": ["district:art_deco", "style:mediterranean_revival"], "then": { "recipe:deco": 0.6 },
      "why": "Miami Beach's Mediterranean Revival hotels share the district's stucco, porches and signs; the deco recipe is the nearest form until a Mediterranean one exists." },

    { "if": ["family:deco"], "then": { "detail:eyebrows": 0.9, "detail:eyebrows_wrap": 0.5, "detail:parapet_bands": 0.85, "detail:tripartite_front": 0.7 },
      "why": "Tropical Deco: cantilevered concrete eyebrows shade each window row; the facade is split in three ('rule of three')." },
    { "if": ["style:streamline_moderne"], "then": { "detail:round_corners": 0.95, "detail:eyebrows_wrap": 0.9, "detail:speed_lines": 0.9, "detail:porthole_windows": 0.5, "detail:glass_block": 0.5 },
      "why": "Streamline Moderne: rounded corners, horizontal speed lines and eyebrows that wrap the corner (the Carlyle, the Marlin, the Tudor)." },
    { "if": ["style:art_deco"], "then": { "detail:round_corners": 0.6, "detail:vertical_fins": 0.6, "detail:central_tower": 0.45, "detail:pylons": 0.35, "detail:twin_fins": 0.2, "detail:keystone_trim": 0.4, "detail:glass_block": 0.3 },
      "why": "Art Deco: vertical fins and a stepped central tower above the roof line (the Colony, the Breakwater), keystone (coral rock) trim." },
    { "if": ["family:deco", "form:lowrise"], "then": { "detail:porch": 0.8, "detail:awnings": 0.75 },
      "why": "Ocean Drive hotels: raised front terraces under the upper floors and fabric awnings over the shop glass." },
    { "if": ["family:deco"], "then": { "detail:accent_trim": 0.55, "palette:deco_pastel": 0.9 },
      "why": "Since the 1980s repainting (Leonard Horowitz) the district is white or pastel with contrasting trim." },
    { "if": ["family:deco", "poi:hotel"], "then": { "detail:neon_sign": 0.9, "detail:neon_parapet": 0.5, "detail:vertical_sign": 0.5 },
      "why": "Deco hotels carry their names in neon, often up the central tower." },
    { "if": ["family:deco", "poi:bar"], "then": { "detail:neon_sign": 0.8 } },
    { "if": ["style:mimo"], "then": { "detail:brise_soleil": 0.6, "detail:cheese_holes": 0.4, "detail:angled_pilotis": 0.4, "detail:balconies": 0.7, "palette:mimo_white": 0.9 },
      "why": "MiMo: sun screens, perforated 'cheese hole' walls, slanted pilotis, white concrete (Morris Lapidus, Gilbert Fein)." },
    { "if": ["recipe:resort_tower"], "then": { "detail:balconies": 0.75, "palette:mimo_white": 0.8 } },

    { "if": ["form:lowrise", "size:small"], "unless": ["family:deco", "poi:shop", "poi:restaurant", "poi:bar", "poi:hotel", "poi:office"], "then": { "recipe:house": 0.6 },
      "why": "A small low building with no business in it is most often a house." },
    { "if": ["form:lowrise", "size:medium"], "unless": ["family:deco", "poi:shop", "poi:restaurant", "poi:bar", "poi:hotel", "poi:office", "district:dense_core"], "then": { "recipe:house": 0.35 } },

{
  "version": 1,
  "about": "Surface rules for the place knowledge graph: facts about a road, a land patch or a wall become surface:* facts, and each surface names a material and its parameters. Same engine as data/knowledge/place-graph.json (weakest 'if' fact, noisy OR, negative weights suppress). Measured facts (measured:*) come from the unbaked aerial photograph, lidar and licensed photographs; they outweigh rules.",
  "season_facts": "season:* comes from the month and the climate (USDA turf dormancy windows).",
  "rules": [
    {"if": ["land:grass", "climate:tropical"], "then": {"surface:turf_st_augustine": 0.85}, "why": "South Florida lawns and parks are mostly St. Augustine grass (UF/IFAS)."},
    {"if": ["land:grass", "climate:humid_subtropical"], "then": {"surface:turf_bermuda": 0.7, "surface:turf_st_augustine": 0.3}, "why": "Bermuda and St. Augustine dominate the US Southeast."},
    {"if": ["land:grass", "climate:continental"], "then": {"surface:turf_cool_season": 0.8}, "why": "Kentucky bluegrass and fescue north of the transition zone."},
    {"if": ["land:grass", "climate:semi_arid"], "then": {"surface:grass_prairie": 0.8}, "why": "Mixed-grass prairie and pasture on the Great Plains."},
    {"if": ["surface:turf_bermuda", "season:dormant_warm"], "then": {"state:dormant_tan": 0.9}, "why": "Bermuda goes dormant and tan below about 10 C soil temperature."},
    {"if": ["surface:grass_prairie", "season:autumn"], "then": {"state:cured_straw": 0.9}, "why": "Prairie grass cures to straw colour after the first frosts."},
    {"if": ["surface:turf_cool_season", "season:autumn"], "then": {"state:green_thin": 0.6}},
    {"if": ["land:sand", "region:florida", "near:sea"], "then": {"surface:sand_quartz_shell": 0.9}, "why": "Miami Beach sand is renourished quartz and shell, light tan."},
    {"if": ["land:forest", "climate:humid_subtropical"], "then": {"surface:leaf_litter_broadleaf": 0.8}},
    {"if": ["land:forest", "region:appalachia"], "then": {"surface:leaf_litter_broadleaf": 0.9, "surface:rock_cut_shale": 0.5}, "why": "Oak-hickory forest; road cuts show shale and metasandstone (Great Smoky Mountains)."},

    {"if": ["road:residential"], "then": {"surface:asphalt_aged": 0.7}, "why": "Local streets are resurfaced every 15-25 years; most are mid-life."},
    {"if": ["road:service"], "then": {"surface:asphalt_patched": 0.7}},
    {"if": ["road:primary"], "then": {"surface:asphalt_mid": 0.7}},
    {"if": ["road:secondary"], "then": {"surface:asphalt_mid": 0.6, "surface:asphalt_aged": 0.3}},
    {"if": ["road:tertiary"], "then": {"surface:asphalt_aged": 0.6}},
    {"if": ["road:surface_concrete"], "then": {"surface:concrete_slabs": 0.95, "surface:asphalt_aged": -0.9, "surface:asphalt_mid": -0.9}},
    {"if": ["road:surface_chipseal"], "then": {"surface:chip_seal": 0.95, "surface:asphalt_mid": -0.9}},
    {"if": ["road:secondary", "region:appalachia", "use:scenic"], "then": {"surface:asphalt_mid": 0.6}, "why": "US 129 is repaved often for its traffic of sports cars and motorcycles."},
    {"if": ["measured:intensity_patchy"], "then": {"surface:asphalt_patched": 0.8}, "why": "Lidar intensity varies in blocks: patches and crack seal."},
    {"if": ["measured:bright_pavement"], "then": {"surface:asphalt_aged": 0.5, "surface:asphalt_mid": -0.4}, "why": "Asphalt bleaches from 0.05 to 0.15-0.2 albedo as the binder wears."},
    {"if": ["road:pedestrian", "district:art_deco"], "then": {"surface:pavers_coral": 0.5, "surface:concrete_sidewalk": 0.5}},

    {"if": ["style:art_deco"], "then": {"surface:stucco_smooth": 0.85}, "why": "Deco and Streamline Moderne walls are smooth cement stucco over block."},
    {"if": ["style:mediterranean"], "then": {"surface:stucco_textured": 0.8}},
    {"if": ["style:mimo"], "then": {"surface:stucco_smooth": 0.5, "surface:concrete_painted": 0.4}},
    {"if": ["region:southwest"], "then": {"surface:stucco_sand_finish": 0.7}},
    {"if": ["recipe:main_street", "era:before_1945"], "then": {"surface:brick_common": 0.85}},
    {"if": ["recipe:house", "region:midwest"], "then": {"surface:vinyl_siding": 0.6, "surface:brick_common": 0.2}},
    {"if": ["recipe:house", "region:southeast"], "then": {"surface:vinyl_siding": 0.4, "surface:brick_common": 0.4}},
    {"if": ["form:tower", "era:after_1990"], "then": {"surface:glass_curtain": 0.7}},
    {"if": ["near:sea"], "then": {"wear:salt_bloom": 0.6}, "why": "Salt air chalks paint within a few hundred metres of the sea."},
    {"if": ["climate:tropical"], "then": {"wear:algae_streaks": 0.5}, "why": "Black algae streaks under sills and roof edges in humid heat."}
  ],
  "materials": {
    "surface:turf_st_augustine": {"layer": "Ground", "class": "veg", "albedo_srgb": [74, 104, 44], "detail": "Grass", "detail_scale_m": 2.3, "detail_amount": 0.55, "library": "ambientcg:Grass004"},
    "surface:turf_bermuda": {"layer": "Ground", "class": "veg", "albedo_srgb": [86, 112, 52], "detail": "Grass", "detail_scale_m": 1.6, "detail_amount": 0.5, "library": "ambientcg:Grass001"},
    "state:dormant_tan": {"tint_srgb": [150, 130, 88], "tint_amount": 0.75},
    "state:cured_straw": {"tint_srgb": [170, 150, 105], "tint_amount": 0.85},
    "state:green_thin": {"tint_srgb": [110, 115, 70], "tint_amount": 0.3},
    "surface:turf_cool_season": {"layer": "Ground", "class": "veg", "albedo_srgb": [70, 100, 46], "detail": "Grass", "detail_scale_m": 1.8, "detail_amount": 0.5},
    "surface:grass_prairie": {"layer": "Ground", "class": "veg", "albedo_srgb": [120, 118, 72], "detail": "Grass", "detail_scale_m": 3.5, "detail_amount": 0.7},
    "surface:sand_quartz_shell": {"layer": "Ground", "class": "sand", "albedo_srgb": [196, 182, 152], "detail": "Sand", "detail_scale_m": 2.9, "detail_amount": 0.25},
    "surface:leaf_litter_broadleaf": {"layer": "Ground", "class": "bare", "albedo_srgb": [92, 72, 50], "detail": "Grain", "detail_scale_m": 1.2, "detail_amount": 0.6, "library": "ambientcg:Ground037"},
    "surface:rock_cut_shale": {"layer": "Ground", "class": "bare", "albedo_srgb": [96, 92, 86], "detail": "Grain", "detail_scale_m": 4.0, "detail_amount": 0.7, "library": "polyhaven:rock_face"},
    "surface:asphalt_mid": {"layer": "Asphalt", "albedo_srgb": [70, 70, 70], "wear": 0.35, "patches": 0.1},
    "surface:asphalt_aged": {"layer": "Asphalt", "albedo_srgb": [98, 96, 92], "wear": 0.6, "patches": 0.25, "crack_seal": 0.35},
    "surface:asphalt_patched": {"layer": "Asphalt", "albedo_srgb": [90, 88, 85], "wear": 0.6, "patches": 0.6, "crack_seal": 0.5},
    "surface:concrete_slabs": {"layer": "Concrete", "albedo_srgb": [170, 166, 158], "joint_spacing_m": 4.5},
    "surface:chip_seal": {"layer": "Asphalt", "albedo_srgb": [110, 104, 96], "wear": 0.3, "aggregate_mm": 10},
    "surface:pavers_coral": {"layer": "Concrete", "albedo_srgb": [200, 186, 160], "joint_spacing_m": 0.3},
    "surface:concrete_sidewalk": {"layer": "Concrete", "albedo_srgb": [175, 172, 165], "joint_spacing_m": 1.5},
    "surface:stucco_smooth": {"layer": "Building", "grain": 0.25, "library": "ambientcg:Plaster001"},
    "surface:stucco_textured": {"layer": "Building", "grain": 0.6, "library": "ambientcg:Plaster003"},
    "surface:stucco_sand_finish": {"layer": "Building", "grain": 0.5},
    "surface:concrete_painted": {"layer": "Building", "grain": 0.35},
    "surface:brick_common": {"layer": "Building", "grain": 0.8, "library": "ambientcg:Bricks076"},
    "surface:vinyl_siding": {"layer": "Building", "grain": 0.2, "lap_m": 0.1},
    "surface:glass_curtain": {"layer": "Building", "grain": 0.0}
  }
}
